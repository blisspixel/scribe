# Scribe Configuration Template
# Copy this file to .env and fill in your values

# Output directory for transcriptions and recordings
SCRIBE_OUTPUT_FOLDER=~/Videos/Transcriptions

# OpenAI API Configuration (required for cloud transcription and AI features)
# Get your API key from: https://platform.openai.com/api-keys
# Use standard OPENAI_API_KEY (or SCRIBE_OPENAI_API_KEY for legacy)
OPENAI_API_KEY=sk-your-api-key-here
SCRIBE_OPENAI_MODEL=gpt-4o-transcribe

# XAI/Grok API Configuration (optional, for cost-efficient AI features)
# Get your API key from: https://console.x.ai/
# Grok 4 Fast is 47x cheaper than GPT-5 for jokes and quick tasks
XAI_API_KEY=xai-your-api-key-here

# AI Provider Selection (optional, defaults shown)
# Choose which provider to use for each feature
SCRIBE_JOKE_PROVIDER=xai          # Use Grok for jokes (fast and cheap)
SCRIBE_MEME_PROVIDER=openai       # Use OpenAI for memes
SCRIBE_NOTES_PROVIDER=openai      # Use OpenAI for notes
SCRIBE_TRANSCRIBE_PROVIDER=openai # Use OpenAI for transcription

# Hugging Face Token (optional, for speaker diarization)
# Get your token from: https://huggingface.co/settings/tokens
SCRIBE_HF_TOKEN=hf_your_token_here

# OBS Studio Configuration (optional, for recording)
SCRIBE_OBS_HOST=localhost
SCRIBE_OBS_PORT=4455
SCRIBE_OBS_PASSWORD=

# Default Transcription Settings
SCRIBE_DEFAULT_MODEL=large-v3
SCRIBE_DEFAULT_LANGUAGE=en
SCRIBE_DEFAULT_METHOD=auto

# Processing Settings
SCRIBE_MAX_RETRIES=3
SCRIBE_PROCESS_TIMEOUT=14400
SCRIBE_FILE_WAIT_TIMEOUT=300

# Feature Flags
SCRIBE_KEEP_INTERMEDIATE_FILES=false
SCRIBE_ENABLE_SILENCE_DETECTION=true
SCRIBE_ENABLE_SPEAKER_DIARIZATION=true

# Audio Output Device (Windows only, optional)
# Set this to your expected audio output device name for validation
# SCRIBE_EXPECTED_AUDIO_OUTPUT=Analog (1+2) (RME-ADI-2 DAC)

# Meme Generation and Humor Settings
SCRIBE_MEME_QA_THRESHOLD=8.0
SCRIBE_MEME_QA_ATTEMPTS=3
SCRIBE_HUMOR_SPICE=5

# Logging Settings (DEBUG, INFO, WARNING, ERROR)
# Set to WARNING to reduce noise, INFO for more details, DEBUG for troubleshooting
SCRIBE_LOG_LEVEL=WARNING
