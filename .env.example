# Scribe Configuration Template
# Copy this file to .env and fill in your values.
#
# Precedence (highest to lowest): CLI flags > env vars (this file) >
# ~/.scribe/config.toml > built-in defaults. Run `scribe init` to write the
# TOML config interactively (auto-prompts on first run).

# Output directory for transcriptions and recordings.
# Overrides the [output] folder written by `scribe init`.
SCRIBE_OUTPUT_FOLDER=~/Videos/Transcriptions

# OpenAI API Configuration (required for cloud transcription and AI features)
# Get your API key from: https://platform.openai.com/api-keys
# Use standard OPENAI_API_KEY (or SCRIBE_OPENAI_API_KEY for legacy)
OPENAI_API_KEY=sk-your-api-key-here
SCRIBE_OPENAI_MODEL=gpt-4o-transcribe

# XAI/Grok API Configuration (optional, for cost-efficient AI features)
# Get your API key from: https://console.x.ai/
# Defaults use current xAI replacement models; verify live pricing before high-volume runs
XAI_API_KEY=xai-your-api-key-here

# Anthropic Claude API Configuration (optional, for Claude AI features)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Google Gemini API Configuration (optional; not in the default fallback chain)
# Only set this if you've explicitly opted into Gemini-backed features.
# Get your API key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# AI Provider Selection (optional, defaults shown)
# Defaults: openai uses gpt-5.5; xai uses grok-4.3 across joke/meme/notes
# Options: openai, xai, anthropic, gemini (transcribe only supports openai)
SCRIBE_JOKE_PROVIDER=xai                # Use Grok 4.3 for jokes
SCRIBE_MEME_PROVIDER=xai                # Use Grok 4.3 for meme concepts (great at humor)
SCRIBE_MEME_IMAGE_PROVIDER=openai       # Use OpenAI for images (Grok adds logo watermark)
SCRIBE_NOTES_PROVIDER=openai            # Use OpenAI gpt-5.5 for notes (xai grok-4.3 also strong)
SCRIBE_TRANSCRIBE_PROVIDER=openai       # Use OpenAI for transcription (only option)

# Bake-off Mode (optional)
# Get jokes/memes from all providers and pick the funniest
# NOTE: Meme bakeoff disabled by default to avoid Grok logo in images
# If you enable it, the winning provider's image generator will be used
SCRIBE_ENABLE_JOKE_BAKEOFF=true
SCRIBE_ENABLE_MEME_BAKEOFF=false

# Meme Generation Settings
# IMPORTANT: XAI/Grok images include a Grok logo watermark in bottom-right corner
# This cannot be disabled via API. Recommended: Use XAI for concepts, OpenAI for images.
# If you want to use XAI images anyway, you'll need to crop/mask the logo in post-processing.

# Meme Text Rendering Method
# "local" = Overlay text with Pillow (default, clean and readable)
# "ai" = Let AI generate text in image (often gibberish or cut-off)
SCRIBE_MEME_TEXT_METHOD=local

# Provider Health Checks (optional)
# Enable automatic health checks and failover
SCRIBE_ENABLE_HEALTH_CHECKS=false

# Hugging Face Token (optional, for speaker diarization)
# Get your token from: https://huggingface.co/settings/tokens
SCRIBE_HF_TOKEN=hf_your_token_here

# OBS Studio Configuration (optional, for recording)
SCRIBE_OBS_HOST=localhost
SCRIBE_OBS_PORT=4455
SCRIBE_OBS_PASSWORD=
# Auto-stop runaway recordings after this many hours (default: 9)
SCRIBE_MAX_RECORDING_HOURS=9
# Warn when the recording reaches this fraction of the max duration (default: 0.9 = 90%)
SCRIBE_RECORDING_WARNING_FRACTION=0.9

# Default Transcription Settings
SCRIBE_DEFAULT_MODEL=large-v3
SCRIBE_DEFAULT_LANGUAGE=en
SCRIBE_DEFAULT_METHOD=auto

# Processing Settings
SCRIBE_MAX_RETRIES=3
SCRIBE_PROCESS_TIMEOUT=14400
SCRIBE_FILE_WAIT_TIMEOUT=300

# Feature Flags
SCRIBE_KEEP_INTERMEDIATE_FILES=false
SCRIBE_ENABLE_SILENCE_DETECTION=true
SCRIBE_ENABLE_SPEAKER_DIARIZATION=true

# Default features per run (can also be set via `scribe init`).
# These env vars OVERRIDE ~/.scribe/config.toml; comment out if you want the
# wizard's choice to win. Per-run --no-notes/--no-joke/--no-meme always wins.
# SCRIBE_ENABLE_NOTES=true
# SCRIBE_ENABLE_JOKE=true
# SCRIBE_ENABLE_MEME=true

# Audio Output Device (Windows only, optional)
# Set this to your expected audio output device name for validation
# SCRIBE_EXPECTED_AUDIO_OUTPUT=Analog (1+2) (RME-ADI-2 DAC)

# Meme Generation and Humor Settings
SCRIBE_MEME_QA_THRESHOLD=8.0
SCRIBE_MEME_QA_ATTEMPTS=3
SCRIBE_HUMOR_SPICE=5

# Logging Settings (DEBUG, INFO, WARNING, ERROR)
# Set to WARNING to reduce noise, INFO for more details, DEBUG for troubleshooting
SCRIBE_LOG_LEVEL=WARNING

# Terminal UI Settings (optional)
# Animation modes: off, light, full
SCRIBE_ANIMATIONS=light
# Color modes: auto, always, never
SCRIBE_COLOR=auto
# Target UI refresh rate (frames per second, clamped 2-30)
SCRIBE_FPS=10
